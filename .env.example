# Copy this file to .env and fill in values. .env is ignored by git.

# REQUIRED — same OAuth Client ID as in .streamlit/secrets.toml.
# The backend uses it to verify that sign-in tokens were issued for this app.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — SQLite file for registered users (created automatically)
DATABASE_PATH=users.db

# Optional — enables the "AI Suggestions" section (free key: https://console.groq.com)
# Also run: pip install groq
GROQ_API_KEY=

# Where the Streamlit frontend finds the FastAPI backend.
#  - Set it  -> "API mode": run the backend (uvicorn) AND the frontend.
#  - Remove it -> "standalone mode": just run `streamlit run frontend/app.py`;
#    the analysis runs inside the Streamlit app (this is how Streamlit Community Cloud runs it).
BACKEND_URL=http://localhost:8000
